{
  "version": 2,
  "installCommand": "corepack enable && yarn install --production=false --ignore-scripts --non-interactive --network-timeout 300000",
  "buildCommand": "yarn build:vercel",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/storage/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/|storage/|assets/|favicon.ico|robots.txt|manifest.webmanifest).*)",
      "destination": "/index.html"
    }
  ]
}
